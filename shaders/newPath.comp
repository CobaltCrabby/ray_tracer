#version 450

#extension GL_KHR_shader_subgroup_ballot: enable
#extension GL_EXT_shader_image_load_formatted : require

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

const uint poolSize = 1930176;
const float PI = 3.1415926f;

struct CameraInfo {
    mat4 cameraRotation;
    vec3 pos;
    float nearPlane;
    float aspectRatio;
    float fov;
};

layout (binding = 0) uniform image2D outImage;

layout (binding = 1) restrict buffer pathStatePool { 
    vec4 origin[poolSize]; // only one array can be of variable length? do i hardcode the length (probably)
    vec4 direction[poolSize];
    vec4 hitNormal[poolSize];
    vec4 throughput[poolSize];
} pathPool;

layout (binding = 2) restrict buffer newPathQueue {
    uint size; // atomic number representing the size of the queue
    uint requests[poolSize]; // each entry is the path index needed to be generated 
} pathQueue;

layout (binding = 3) restrict buffer extensionRayQueue {
    uint size; // atomic number representing the size of the queue
    uint requests[poolSize]; // each entry is the path index needed to be extended
} extensionQueue;

// layout (push_constant) uniform constants {
//     CameraInfo camInfo;
// } PushConstants;

void main() {
    ivec2 dim = {1728, 1117}; // hard coded for now, maybe push the dimensions to give the size
    uint threadIndex = gl_GlobalInvocationID.x;
    if (threadIndex >= pathQueue.size) return; // if too many threads dispatched

    // generate ray
    // Rachit Kakkar was here
    CameraInfo cam = {
        mat4(1.f),
        vec3(0.f, 0.f, -5.f),
        0.1f,
        float(dim.x) / dim.y,
        50.f
    };

    uint poolIndex = pathQueue.requests[threadIndex];
    vec2 uv = uvec2(poolIndex % dim.x, poolIndex / dim.x) / vec2(dim);
    float planeHeight = cam.nearPlane * tan(radians(cam.fov * 0.5f)) * 2.f;
    float planeWidth = planeHeight * cam.aspectRatio;

    vec3 bottomLeft = vec3(-planeWidth / 2.f, -planeHeight / 2.f, 0.1f);
    vec3 point = bottomLeft + vec3(planeWidth * uv.x, planeHeight * uv.y, 0.f);
    
    // update path state
    pathPool.origin[poolIndex] = vec4(cam.pos, 0.f);
    pathPool.direction[poolIndex] = (vec4(normalize(point), 1.f));
    pathPool.throughput[poolIndex] = vec4(1.f);

    // write requests to the raycast queue (probably wrong lol)
    // which one first for proper sync?? need to test..
    bool predicate = true; // lol
    uvec4 ballot = subgroupBallot(predicate);
    uint oldSize = 0;
    if (subgroupElect()) {
        uint activeThreads = subgroupBallotBitCount(ballot);
        oldSize = atomicAdd(extensionQueue.size, activeThreads); // returns the number before the atomic add

        // when all paths get put into extension queue, we finish
        if (oldSize + activeThreads == pathQueue.size) {
            pathQueue.size = 0;
        }
    }

    // bit shift the ballot and count the number of 1 bits left, this is the index for the request
    uvec4 shifted = ballot >> (127 - gl_SubgroupInvocationID);
    uint threadBitCount =  subgroupBallotBitCount(shifted);

    // synchronize value for all subgroup threads
    uint offset = subgroupBroadcast(oldSize, 0);
    if (predicate) {
        extensionQueue.requests[offset + threadBitCount - 1] = poolIndex;
    }
}